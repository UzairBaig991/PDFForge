Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|README\.md)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^api/(upload|process|status|download|delete|tools)\.php$ api.php?action=$1 [QSA,L,NC]
RewriteRule ^tools/(?!tools\.php$|tool-template\.php$)([a-z0-9-]+)\.php$ tools/tool-template.php?tool=$1 [QSA,L,NC]
RewriteRule ^(app|config|database|includes|storage|vendor)/ - [F,L,NC]
